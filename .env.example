# saasy-signal environment
# Copy to .env for local development. Values below are local-stack defaults;
# config/default.toml provides the same defaults, so only set what you change.

HOST=127.0.0.1
PORT=3000

# Media plane (saasy-sfu)
SFU_HTTP_URL=http://127.0.0.1:9091
SFU_GRPC_URL=http://127.0.0.1:50051

# Auth service (saasy-core) gRPC, for usage/budget tracking
CORE_GRPC_URL=http://localhost:9092

ACTIX_WORKERS=2

RUST_LOG=info

# PEM-encoded ES256 public key matching saasy-core's JWT_PRIVATE_KEY.
# Signal validates session JWTs with this key; it never mints tokens.
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...your key from saasy-core...
-----END PUBLIC KEY-----"

# TURN server (optional). All four must be set together, or none at all.
# Without them, clients behind restrictive NATs may fail to connect.
# COTURN_HOST=turn.example.com
# COTURN_PORT=3478
# COTURN_SHARED_SECRET=change-me
# COTURN_CREDENTIAL_TTL=86400
